{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Api": {
    "Versions": {
      "v1": {
        "Name": "API v1",
        "Description": "Initial API version"
      }
    }
  },
  "Database": {
    "Postgres": {
      "ConnectionString": "Host=<DB_HOST>;Port=<DB_PORT>;Database=<DB_NAME>;Username=<DB_USER>;Password=<DB_PASSWORD>"
    }
  },
  "Cors": {
    "DevelopmentOrigins": [
      "YOUR_DOMAIN"
    ],
    "ProductionOrigins": [
      "YOUR_DOMAIN"
    ]
  },
  "Auth": {
    "Jwt": {
      "Issuer": "<JWT_ISSUER>",
      "Audience": "<JWT_AUDIENCE>",
      "ExpirationInMinutes": 30,
      "ExpirationInDays": 7
    }
  }
}
