{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Api": {
    "Versions": {
      "v1": {
        "Name": "AuthCore API v1",
        "Description": "Local development API version"
      }
    }
  },
  "Database": {
    "Postgres": {
      "ConnectionString": "Host=localhost;Port=5432;Database=app;Username=postgres;Password=root",
      "CommandTimeoutSeconds": 30,
      "RetryCount": 3,
      "RetryDelayMilliseconds": 200,
      "Cleanup": {
        "Enabled": true,
        "IntervalMinutes": 60,
        "RevokedRetentionDays": 30
      }
    },
    "Redis": {
      "ConnectionString": "localhost:6379,password=root,abortConnect=false",
      "KeyPrefix": "authcore:dev"
    }
  },
  "Cors": {
    "DevelopmentOrigins": [
      "http://localhost:3000"
    ],
    "ProductionOrigins": [
      "http://localhost:3000"
    ]
  },
  "Security": {
    "Jwt": {
      "Issuer": "authcore.local",
      "Audience": "authcore.local.client",
      "ExpiresInMinutes": 30
    },
    "Session": {
      "ExpiresInDays": 7,
      "MaxLifetimeInDays": 30,
      "MaxSessionsPerUser": 4
    },
    "Abuse": {
      "SignInIpPerMinute": 20,
      "SignInEmailPerMinute": 10,
      "RefreshPerMinute": 60
    },
    "LoginAttempts": {
      "MaxAttempts": 5,
      "LockDurationMinutes": 15
    },
    "ConfirmCode": {
      "ExpiresInMinutes": 10,
      "MaxAttempts": 5
    },
    "ConfirmCodeAbuse": {
      "ResendCooldownMinutes": 2,
      "WindowMinutes": 1440,
      "MaxCodesPerWindow": 3,
      "IpPerMinute": 60,
      "IpPerMinutePerEndpoint": 20
    },
    "Cookies": {
      "SessionKey": "__Host-session",
      "AccessTokenKey": "__Host-access_token"
    },
    "Keys": {
      "Symmetric": {
        "PrivateKey": "5BhduiSH6unGEEwqpPowSvfzn3aHLhapcIysAArV8Mf"
      },
      "Asymmetric": {
        "PrivateKeyPath": "/authcore/private_key.pem",
        "PublicKeyPath": "/authcore/public_key.pem"
      }
    }
  },
  "RabbitMQ": {
    "Host": "localhost",
    "Port": 5672,
    "User": "guest",
    "Password": "root",
    "EmailQueue": "authcore.email",
    "DeadLetterQueue": "authcore.email.dlq"
  }
}